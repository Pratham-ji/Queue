generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. THE USER (Doctors, Patients, Staff)
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  phone    String?
  role     Role    @default(PROVIDER)

  // --- NEW VERIFICATION FIELDS ---
  phoneVerified   Boolean @default(false) // For OTP Status
  aadhaarVerified Boolean @default(false) // For DigiLocker Status
  livePhotoUrl    String? // The "Selfie" URL
  // -------------------------------

  // --- NEW TELEHEALTH CREDITS ---
  credits Int @default(100) // For the Telehealth & Messaging Module
  // ------------------------------

  createdAt DateTime @default(now())

  // Relations...
  clinicId      String?
  clinic        Clinic?        @relation("ClinicToUser", fields: [clinicId], references: [id])
  ownedClinics  Clinic[]       @relation("ClinicOwner")
  doctorProfile DoctorProfile?
  appointments  Appointment[]
  chatThreads   ChatThread[]

  // M:N clinic memberships (marketplace model)
  clinicMemberships ClinicMember[]
}

// 2. THE CLINIC
model Clinic {
  id          String  @id @default(uuid())
  name        String
  address     String
  city        String  @default("Dehradun")
  image       String  @default("")
  rating      Float   @default(4.5)
  description String?
  verified    Boolean @default(false)

  // --- NEW DOCS ---
  addressProofUrl String? // Utility bill or Registration deed
  // ----------------
  
  // --- EMERGENCY STATUS ---
  isEmergencyPause Boolean @default(false)
  emergencyMessage String?
  // ------------------------

  createdAt DateTime @default(now())

  // Owner relationship (not unique - provider can own multiple clinics)
  ownerId String?
  owner   User?   @relation("ClinicOwner", fields: [ownerId], references: [id])

  // Relations...
  users    User[]          @relation("ClinicToUser")
  doctors  DoctorProfile[]
  patients Patient[]

  // M:N provider memberships (marketplace model)
  members ClinicMember[]

  prescriptions Prescription[]
}

// 3. THE PATIENT (Queue Items - Walk-ins)
model Patient {
  id     String      @id @default(uuid())
  token  Int
  name   String
  phone  String?
  type   VisitType   @default(CHECKUP)
  status QueueStatus @default(WAITING)

  arrivalTime   DateTime  @default(now())
  servedTime    DateTime?
  completedTime DateTime?

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  expoPushToken String? // Expo Push Token for lock-screen notifications

  prescriptions Prescription[]
}

// 4. THE APPOINTMENT (Booked Online)
model Appointment {
  id          String @id @default(uuid())
  date        String
  time        String
  status      String @default("CONFIRMED")
  patientName String

  doctorId String?
  doctor   DoctorProfile? @relation(fields: [doctorId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// 5. DOCTOR PROFILE (Details for the Doctor)
model DoctorProfile {
  id         String  @id @default(uuid())
  name       String
  specialty  String
  experience Int
  image      String
  rating     Float   @default(4.8)
  price      Int
  about      String?

  // --- NEW LICENSE FIELDS ---
  licenseNumber    String? // e.g. "MCI-12345"
  registrationYear Int? // e.g. 2018
  licenseCertUrl   String? // URL to the uploaded file
  degreeCertUrl    String? // URL to the degree
  // --------------------------

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  appointments  Appointment[]
  prescriptions Prescription[]
  chatThreads   ChatThread[]
}

// 6. INSTANT QUEUE (USP Feature)
model CustomSession {
  id        String   @id @default(uuid())
  hostName  String
  title     String
  joinCode  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  participants SessionParticipant[]
}

model SessionParticipant {
  id       String   @id @default(uuid())
  name     String
  token    Int
  status   String   @default("WAITING")
  joinedAt DateTime @default(now())

  sessionId String
  session   CustomSession @relation(fields: [sessionId], references: [id])
}

// --- ENUMS ---
enum Role {
  PATIENT
  PROVIDER
  ADMIN
  STAFF
}

enum VisitType {
  CHECKUP
  EMERGENCY
  REPORT
  FOLLOWUP
}

enum QueueStatus {
  WAITING
  SERVING
  COMPLETED
  MISSED
}

// --- M:N MARKETPLACE MODEL ---

// Junction table: which users work at which clinics, and in what role
model ClinicMember {
  id        String     @id @default(uuid())
  role      ClinicRole @default(STAFF)
  isPrimary Boolean    @default(false) // user's "active" clinic for this session
  joinedAt  DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId]) // prevent duplicate memberships
}

enum ClinicRole {
  OWNER
  DOCTOR
  STAFF
  PHARMACIST
}

// 7. PRESCRIPTION RELAY (Advanced Pharmacy Integration)
model Prescription {
  id        String   @id @default(uuid())
  medicines Json // Array: [{ name, dosage, duration }]
  notes     String?
  createdAt DateTime @default(now())

  // --- NEW PHARMACY PIPELINE ---
  pharmacyStatus PharmacyStatus @default(PENDING)
  otpCode        String?
  // -----------------------------

  // The walk-in queue patient
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // The doctor who wrote it
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  // The clinic pharmacy where it will be fulfilled
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
}

enum PharmacyStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

// 8. TELEHEALTH & MESSAGING
model ChatThread {
  id        String   @id @default(uuid())
  isActive  Boolean  @default(true) // If true, bypasses credit checks
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  senderId  String   // Either userId or doctor.userId
  createdAt DateTime @default(now())

  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}
